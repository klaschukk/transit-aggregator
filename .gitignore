# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.env
*.egg-info/

# DuckDB and raw data (rebuilt by pipelines)
data/dbs/
data/raw/
data/gtfs/*.txt
data/gtfs/*.html

# Google Search Console snapshots (regenerated weekly)
data/gsc/
.gsc-credentials.json
*.gsc-credentials.json

# Secrets (IndexNow key, future API tokens). The IndexNow key is
# also served at /<key>.txt for domain verification — that's
# public-by-design, but keeping it out of git keeps grep clean.
data/secrets/

# Scraper progress/cache files
*_progress.json
city_ids.json
suspicious_stops.json

# Logs
logs/
*.log

# Lighthouse + perf reports (regenerated by scripts/perf_check.sh and
# scripts/lighthouse_ci.sh). Raw JSON is heavy (~400 KB/report × 12),
# and each one is reproducible; commit only the summary markdown.
reports/
docs/06_tech/lh-baseline/

# OS
.DS_Store
*.swp
Thumbs.db

# IDE
.vscode/
.idea/

# Other projects
benovite.com/

.gstack/
data/transit.db
seonaut-main/

# Generated at deploy time
data/cache/
app/static/css/dist/
app/static/js/dist/
data/backups/
